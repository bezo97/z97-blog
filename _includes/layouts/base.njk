<!doctype html>
<html lang="{{ metadata.language }}">
	<head prefix="og: http://ogp.me/ns#">
		<meta charset="utf-8">
    	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<meta name="author" content="{{ author or 'bezo97' }}" />
		<meta
			name="copyright"
			content="Copyright {{ author or 'bezo97' }}"
		/>
   	    <meta name="robots" content="index, follow" />
    	<meta name="keywords" content="bezo97,blog,{{ tags }}" />

		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">

		<!--Useless tags, nice to have-->
		<meta name="generator" content="{{ eleventy.generator }}">
    	<meta name="subject" content="personal">
    	<meta name="language" content="en-US" />
		<meta name="rating" content="general" />
		<meta name="distribution" content="global" />
		
    	<link rel="icon" href="/img/favicon.ico" type="image/x-icon" />
    	<meta name="theme-color" content="#1e88e5" />

		{% if tags %} 
			<!-- Structured data for the blog post -->
			<script type="application/ld+json" eleventy:ignore>
			{
				"@context": "https://schema.org/",
				"@type": "BlogPosting",
				"@id": "{{ metadata.url }}{{ page.url }}",
				"mainEntityOfPage": "{{ metadata.url }}{{ page.url }}",
    			"url": "{{ metadata.url }}{{ page.url }}",
				"headline": "{{ title | escape }}",
				"name": "{{ title | escape }}",
				"description": "{{ description | escape }}",
				"author": {
					"@type": "Person",
					"name": "{{ author or 'bezo97' | escape }}"
				},
				"datePublished": "{{ date | htmlDateString }}",
				"image": {
					"@type": "ImageObject",
					"@id": "{{ metadata.url }}/img/social-bg.webp",
					"url": "{{ metadata.url }}/img/social-bg.webp",
					"height": "720",
					"width": "720"
				},
				"isPartOf": {
					"@type" : "Blog",
					"@id": "{{ metadata.url }}",
					"name": "{{ metadata.title }}"
				},
				"keywords": "{{ tags }}"
			}
			</script>
			<!-- Open Graph -->
			<meta property="og:type" content="article"/>
			<meta property="og:title" content="{{ title }}"/>
			<meta property="og:url" content="{{ metadata.url }}{{ page.url }}"/>
			<meta property="og:description" content="{{ description }}" />
			<meta property="og:image" content="{{ metadata.url }}/img/social-bg.webp"/>
			<meta property="article:published_time " content="{{ date | htmlDateString }}"/>
			<meta property="article:author" content="https://bio.z97.io"/>
			<meta property="article:publisher" content="{{ metadata.url }}"/>
			<meta property="article:section" content="personal blog"/>
			{%- for tag in tags %}
				<meta property="article:tag" content="{{ tag }}"/>
			{%- endfor %}
			<!-- Twitter Card -->
			<meta name="twitter:card" content="summary_large_image">
			<meta name="twitter:title" content="{{ title }}">
			<meta name="twitter:site" content="@ZotyaDocs">
			<meta name="twitter:description" content="{{ description }}">
			<meta name="twitter:image" content="{{ metadata.url }}/img/social-bg.webp">
			<meta name="twitter:image:alt" content="city lights">

		{% else %}

			<!-- Structured data for the blog -->
			<script type="application/ld+json" eleventy:ignore>
			{
				"@context": "https://schema.org/",
				"@type": "Blog",
				"@id": "{{ metadata.url }}",
				"mainEntityOfPage": "{{ metadata.url }}",
				"name": "{{ metadata.title }}",
				"description": "{{ metadata.description }}",
				"image": {
					"@type": "ImageObject",
					"@id": "{{ metadata.url }}/img/social-bg.webp",
					"url": "{{ metadata.url }}/img/social-bg.webp",
					"height": "720",
					"width": "720"
				}
			}
			</script>
			<!-- Open Graph -->
			<meta property="og:type" content="website"/>
			<meta property="og:title" content="{{ metadata.title }}"/>
			<meta property="og:url" content="{{ metadata.url }}"/>
			<meta property="og:image" content="{{ metadata.url }}/img/social-bg.webp"/>
			<meta property="og:description" content="{{ metadata.description }}"/>
			<!-- Twitter Card -->
			<meta name="twitter:card" content="summary_large_image">
			<meta name="twitter:title" content="{{ metadata.title }}">
			<meta name="twitter:site" content="@ZotyaDocs">
			<meta name="twitter:description" content="{{ metadata.description }}">
			<meta name="twitter:image" content="{{ metadata.url }}/img/social-bg.webp">
			<meta name="twitter:image:alt" content="city lights">
		{% endif %}

		{#-
		Plain-text bundles are provided via the `eleventy-plugin-bundle` plugin:
		1. CSS:
			* Add to a per-page bundle using `{% css %}{% endcss %}`
			* Retrieve bundle content using `{% getBundle "css" %}` or `{% getBundleFileUrl "css" %}`
		2. Or for JavaScript:
			* Add to a per-page bundle using `{% js %}{% endjs %}`
			* Retrieve via `{% getBundle "js" %}` or `{% getBundleFileUrl "js" %}`
		3. Learn more: https://github.com/11ty/eleventy-plugin-bundle
		#}

		{#- Add CSS to the bundle #}
		<style>/* This is an arbitrary CSS string added to the bundle */</style>

		{#- Add the contents of a file to the bundle #}
		<style>{% include "css/pico.classless.indigo.min.css" %}</style>
		<style>{% include "css/index.css" %}</style>

		{#- Or you can add from node_modules #}
		{# <style>{% include "node_modules/something.css" %}</style> #}

		{#- Render the CSS bundle using inlined CSS (for the fastest site performance in production) #}
		<style>{% getBundle "css" %}</style>

		{#- Renders the CSS bundle using a separate file, if you can't set CSP directive style-src: 'unsafe-inline' #}
		{#- <link rel="stylesheet" href="{% getBundleFileUrl "css" %}"> #}

		{#- Add the heading-anchors web component to the JavaScript bundle #}
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body>
		<header>
			{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
			<nav>
				<ul>
					<li><a href="/"><img eleventy:ignore src="/img/logo.webp" alt="Logo" width="45" height="45"/></a></li>
					<li><strong><a href="/">{{ metadata.title }}</a></strong></li>
				</ul>
				<ul class="nav">
				{%- for entry in collections.all | eleventyNavigation %}
					<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
				{%- endfor %}
				</ul>
			</nav>
		</header>

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer>
			<p>
				⛵
			</p>
		</footer>

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
